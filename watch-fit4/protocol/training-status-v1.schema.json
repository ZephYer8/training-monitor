{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZephYer8/training-monitor/watch-fit4/protocol/training-status-v1.schema.json",
  "title": "Training Monitor Watch Status Payload",
  "type": "object",
  "required": [
    "type",
    "version",
    "title",
    "summary",
    "status",
    "epoch",
    "total_epochs",
    "updated_at",
    "metrics"
  ],
  "properties": {
    "type": {
      "const": "training_status"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "maxLength": 160
    },
    "run_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "run_name": {
      "type": "string",
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": ["idle", "training", "finished", "error"]
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "total_epochs": {
      "type": "integer",
      "minimum": 0
    },
    "progress_percent": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "metric_name": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "current_metric": {
      "type": ["number", "null"]
    },
    "best_metric": {
      "type": ["number", "null"]
    },
    "best_epoch": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "eta_seconds": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "updated_at": {
      "type": "string"
    },
    "gpu_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "maxItems": 16
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "display_name", "current", "best", "best_epoch"],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "display_name": {
            "type": "string",
            "maxLength": 32
          },
          "current": {
            "type": ["number", "null"]
          },
          "best": {
            "type": ["number", "null"]
          },
          "best_epoch": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "maxItems": 8
    }
  },
  "additionalProperties": false
}
