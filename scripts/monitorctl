#!/usr/bin/env bash
set -euo pipefail
umask 077

if [ -z "${TRAINING_MONITOR_HOME:-}" ]; then
    if [ "$(id -u)" = "0" ] && [ -d "/root/autodl-tmp" ]; then
        BASE="/root/autodl-tmp/training-monitor"
    else
        BASE="$HOME/.training-monitor"
    fi
else
    BASE="$TRAINING_MONITOR_HOME"
fi

CONFIG_FILE="$BASE/config.env"
SERVER_DIR="$BASE/server"
VENV_PY="$BASE/venv/bin/python"
TOKEN_FILE="$BASE/token.txt"
STATE_FILE="$BASE/state.json"
LOG_DIR="$BASE/logs"
BACKEND_PID="$BASE/backend.pid"
WATCHER_PID="$BASE/watcher.pid"

mkdir -p "$LOG_DIR"
chmod 700 "$BASE" "$LOG_DIR" 2>/dev/null || true

die() {
    echo "$1" >&2
    exit 1
}

write_default_config() {
    [ -f "$CONFIG_FILE" ] && return
    cat > "$CONFIG_FILE" <<EOF
PORT=6006
PUBLIC_URL=
LOG_ROOTS=/root/mmdetection* /root/mmsegmentation* /root/mmclassification* /root/mmpretrain* /root/mmpose* /root/mmrotate* /root/mmocr* /root/mmaction* /root/mmagic* /root/autodl-tmp /root/workspace /root/runs
LOG_TYPE=auto
AUTO_WATCH=1
TOTAL_EPOCHS=0
SCAN_INTERVAL=10
CORS_ORIGINS=
EOF
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

load_config() {
    write_default_config

    local old_log_roots="/root/mmsegmentation* /root/autodl-tmp /root/workspace /root/runs /root"
    if [ "$(read_config_value LOG_ROOTS "")" = "$old_log_roots" ]; then
        save_config_value LOG_ROOTS "/root/mmdetection* /root/mmsegmentation* /root/mmclassification* /root/mmpretrain* /root/mmpose* /root/mmrotate* /root/mmocr* /root/mmaction* /root/mmagic* /root/autodl-tmp /root/workspace /root/runs"
    fi

    PORT="${TRAINING_MONITOR_PORT:-$(read_config_value PORT 6006)}"
    PUBLIC_URL="$(read_config_value PUBLIC_URL "")"
    LOG_ROOTS="$(read_config_value LOG_ROOTS "/root/mmdetection* /root/mmsegmentation* /root/mmclassification* /root/mmpretrain* /root/mmpose* /root/mmrotate* /root/mmocr* /root/mmaction* /root/mmagic* /root/autodl-tmp /root/workspace /root/runs")"
    LOG_TYPE="$(read_config_value LOG_TYPE auto)"
    AUTO_WATCH="$(read_config_value AUTO_WATCH 1)"
    TOTAL_EPOCHS="$(read_config_value TOTAL_EPOCHS 0)"
    SCAN_INTERVAL="$(read_config_value SCAN_INTERVAL 10)"
    CORS_ORIGINS="$(read_config_value CORS_ORIGINS "")"
}

read_config_value() {
    local key="$1"
    local fallback="$2"
    local line
    line="$(grep -m 1 "^$key=" "$CONFIG_FILE" 2>/dev/null || true)"
    if [ -n "$line" ]; then
        printf '%s' "${line#*=}"
    else
        printf '%s' "$fallback"
    fi
}

save_config_value() {
    local key="$1"
    local value="$2"
    local tmp="$CONFIG_FILE.tmp.$$"
    write_default_config
    awk -v key="$key" -v value="$value" '
        BEGIN { done = 0 }
        index($0, key "=") == 1 { print key "=" value; done = 1; next }
        { print }
        END { if (!done) print key "=" value }
    ' "$CONFIG_FILE" > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE" 2>/dev/null || true
}

detect_public_url() {
    load_config
    if [ -n "$PUBLIC_URL" ]; then
        echo "$PUBLIC_URL"
        return
    fi

    local autodl_var="AutoDLService${PORT}URL"
    local autodl_url="${!autodl_var:-${AutoDLServiceURL:-}}"
    if [ -n "$autodl_url" ]; then
        echo "$autodl_url"
        return
    fi

    local ip
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    if [ -n "$ip" ]; then
        echo "http://$ip:$PORT"
    else
        echo "http://SERVER_IP:$PORT"
    fi
}

ensure_runtime() {
    [ -x "$VENV_PY" ] || die "Not installed. Run install.sh first."
    [ -d "$SERVER_DIR" ] || die "server directory not found. Reinstall first."
}

pid_alive() {
    [ -f "$1" ] && kill -0 "$(cat "$1")" >/dev/null 2>&1
}

token_init() {
    ensure_runtime
    if [ ! -s "$TOKEN_FILE" ]; then
        "$VENV_PY" - <<'PY' > "$TOKEN_FILE"
import secrets
print(secrets.token_urlsafe(24))
PY
    fi
    chmod 600 "$TOKEN_FILE"
}

rotate_token() {
    ensure_runtime
    "$VENV_PY" - <<'PY' > "$TOKEN_FILE"
import secrets
print(secrets.token_urlsafe(24))
PY
    chmod 600 "$TOKEN_FILE"
    echo "token rotated"
    restart
    connection
}

start() {
    ensure_runtime
    load_config
    token_init

    if pid_alive "$BACKEND_PID"; then
        echo "server already running, pid=$(cat "$BACKEND_PID")"
    else
        cd "$SERVER_DIR"
        nohup env \
            MONITOR_TOKEN="$(cat "$TOKEN_FILE")" \
            TRAINING_MONITOR_STATE_FILE="$STATE_FILE" \
            TRAINING_MONITOR_CORS_ORIGINS="$CORS_ORIGINS" \
            "$VENV_PY" -m uvicorn app:app --host 0.0.0.0 --port "$PORT" \
            > "$LOG_DIR/backend.log" 2>&1 &
        echo $! > "$BACKEND_PID"
        sleep 2
        echo "server started, pid=$(cat "$BACKEND_PID"), port=$PORT"
    fi

    if [ "$AUTO_WATCH" = "1" ]; then
        auto_watch
    fi
}

stop_one() {
    local file="$1"
    local name="$2"
    if pid_alive "$file"; then
        kill "$(cat "$file")" || true
        rm -f "$file"
        echo "$name stopped"
    fi
}

stop_all() {
    stop_one "$WATCHER_PID" "watcher"
    stop_one "$BACKEND_PID" "server"
}

restart() {
    stop_all
    start
}

status() {
    ensure_runtime
    load_config
    token_init
    "$VENV_PY" - <<PY
import json
import requests
from pathlib import Path

state_file = Path("$STATE_FILE")

try:
    response = requests.get(
        "http://127.0.0.1:$PORT/api/status",
        headers={"X-Monitor-Token": "$(cat "$TOKEN_FILE")"},
        timeout=5,
    )
    print("HTTP", response.status_code)
    print(json.dumps(response.json(), ensure_ascii=False, indent=2))
except Exception as exc:
    print("server unavailable:", exc)
    if state_file.exists():
        print("local cached state:")
        print(json.dumps(json.loads(state_file.read_text(encoding="utf-8")), ensure_ascii=False, indent=2))
PY
}

connection() {
    load_config
    token_init
    echo "server port: $PORT"
    echo "backend url: $(detect_public_url)"
    echo "access token: $(cat "$TOKEN_FILE")"
}

setup() {
    ensure_runtime
    write_default_config
    load_config

    read -r -p "Port [$PORT]: " input_port
    [ -n "$input_port" ] && save_config_value PORT "$input_port"

    read -r -p "Public URL [$(detect_public_url)]: " input_url
    [ -n "$input_url" ] && save_config_value PUBLIC_URL "$input_url"

    read -r -p "Log roots [$LOG_ROOTS]: " input_roots
    [ -n "$input_roots" ] && save_config_value LOG_ROOTS "$input_roots"

    read -r -p "Log type auto/openmmlab/yolo [${LOG_TYPE:-auto}]: " input_type
    [ -n "$input_type" ] && save_config_value LOG_TYPE "$input_type"

    read -r -p "Auto watch 1/0 [$AUTO_WATCH]: " input_watch
    [ -n "$input_watch" ] && save_config_value AUTO_WATCH "$input_watch"

    read -r -p "CORS origins, usually empty [$CORS_ORIGINS]: " input_cors
    [ -n "$input_cors" ] && save_config_value CORS_ORIGINS "$input_cors"

    echo "saved: $CONFIG_FILE"
    connection
}

config_cmd() {
    write_default_config
    case "${1:-show}" in
        show)
            cat "$CONFIG_FILE"
            ;;
        set)
            [ $# -ge 3 ] || die "usage: training-monitor config set KEY VALUE"
            save_config_value "$2" "$3"
            ;;
        path)
            echo "$CONFIG_FILE"
            ;;
        *)
            die "usage: training-monitor config show|set|path"
            ;;
    esac
}

watch_file() {
    ensure_runtime
    load_config
    token_init
    start

    local log_path="${1:-}"
    local total_epochs="${2:-$TOTAL_EPOCHS}"
    [ -n "$log_path" ] || die "usage: training-monitor watch-file /path/to/log-or-results.csv [total_epochs]"
    [ -f "$log_path" ] || die "file not found: $log_path"

    stop_one "$WATCHER_PID" "old watcher"

    cd "$SERVER_DIR"
    nohup env MONITOR_TOKEN="$(cat "$TOKEN_FILE")" "$VENV_PY" auto_watch.py \
        --server-url "http://127.0.0.1:$PORT" \
        --total-epochs "$total_epochs" \
        --interval 5 \
        --roots "$log_path" \
        > "$LOG_DIR/watcher.log" 2>&1 &
    echo $! > "$WATCHER_PID"
    echo "watching: $log_path"
}

auto_watch() {
    ensure_runtime
    load_config
    token_init

    if pid_alive "$WATCHER_PID"; then
        echo "watcher already running, pid=$(cat "$WATCHER_PID")"
        return
    fi

    cd "$SERVER_DIR"
    # shellcheck disable=SC2086
    nohup env MONITOR_TOKEN="$(cat "$TOKEN_FILE")" "$VENV_PY" auto_watch.py \
        --server-url "http://127.0.0.1:$PORT" \
        --total-epochs "$TOTAL_EPOCHS" \
        --interval "$SCAN_INTERVAL" \
        --roots $LOG_ROOTS \
        > "$LOG_DIR/watcher.log" 2>&1 &
    echo $! > "$WATCHER_PID"
    echo "auto training log detection started"
}

logs() {
    echo "backend log: $LOG_DIR/backend.log"
    tail -n 80 "$LOG_DIR/backend.log" 2>/dev/null || true
    echo
    echo "watcher log: $LOG_DIR/watcher.log"
    tail -n 80 "$LOG_DIR/watcher.log" 2>/dev/null || true
}

case "${1:-help}" in
    token-init) token_init ;;
    start) start ;;
    stop) stop_all ;;
    restart) restart ;;
    status) status ;;
    token) token_init; cat "$TOKEN_FILE"; echo ;;
    rotate-token) rotate_token ;;
    connection) connection ;;
    setup) setup ;;
    config) shift; config_cmd "$@" ;;
    watch-file) shift; watch_file "$@" ;;
    watch-mmseg) shift; watch_file "$@" ;;
    auto-watch) auto_watch ;;
    auto-mmseg) auto_watch ;;
    logs) logs ;;
    help|*)
        echo "usage: training-monitor start|stop|restart|status|token|rotate-token|connection|setup|config|watch-file|auto-watch|logs"
        ;;
esac
